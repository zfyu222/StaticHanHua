# This repository is the StaticHanHua toolchain workspace.  Individual games
# are separate, local-only projects and must never be committed here.
/Projects/
/Tools/dnSpy-net-win64/
/Tools/*.zip
/font.tga

# Local agent/editor state
/.agents/
/.codebuddy/
/.codex/
/.git/

# Local configuration can contain machine-specific paths and credentials.
/.mcp.json
/Tools/localization/api.local.json
/Tools/localization/api.local.jsonc

# Root-level runtime artifacts
*.log
*.tmp
*.bak
*.bak0000
*.bak_*
__pycache__/
*.py[cod]
*.obj
.venv/
venv/
bin/
obj/
artifacts/
build/
dist/
*.user
*.suo
.vs/
.vscode/
.idea/
Thumbs.db
Desktop.ini

# REA native analysis dependencies and local verification outputs
/Tools/REA/node_modules/
/Tools/REA/runtime/
/Tools/REA/verification/
/Tools/localization/verification/
/Tools/Ghidra/
/Tools/Java/

# Disposable translation-run history inside framework experiments
/Development/**/TranslateFiles/history/
